PROJECT_NAME="DFX Solution Enterprise SaaS API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:password@db.ref.supabase.co:5432/postgres"
SYNC_DATABASE_URL="postgresql://postgres:password@db.ref.supabase.co:5432/postgres"

# REQUIRED to run pytest — must be a SEPARATE database from DATABASE_URL above.
# tests/conftest.py refuses to start (before touching any database) if this
# is unset or identical to DATABASE_URL. Never point this at a shared dev,
# staging, or production database — pytest tests create and, in several
# cases, do not clean up rows.
TEST_DATABASE_URL="postgresql+asyncpg://postgres:password@db.other-test-ref.supabase.co:5432/postgres"

# CORS Origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# JWT Configuration
SECRET_KEY="your-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset / Email Verification token lifetimes (Module 18)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Email delivery (Module 18) — leave SMTP_HOST empty to use the console/log
# provider (default, no real email sent, safe for local dev). Set all of the
# below to switch to real SMTP delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@dfxsolution.com"
SMTP_FROM_NAME="DFX Solution"
SMTP_USE_TLS=True

# Base URL the frontend is served from — used to build password-reset and
# email-verification links in outbound emails.
FRONTEND_URL="http://localhost:3000"

# SuperAdmin Integrations — leave empty to leave the provider "Not
# configured" (truthfully reported via GET /superadmin/integrations, never
# faked as connected). Setting these is the entire "configure" step; no code
# or UI change is needed once real credentials are available.
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_API_KEY=""
SMS_SENDER_ID=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Encrypts SuperAdmin-entered integration credentials (Configure form) at
# rest — required before that flow can be used at all; without it, saving a
# credential fails with an honest configuration error instead of ever
# storing plaintext. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=""




